<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org: keeps builds reproducible and independent of machine-wide (e.g. corporate) feeds. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
