# Copy to .env (git-ignored) to override docker-compose defaults.
POSTGRES_DB=skyjourney
POSTGRES_USER=skyjourney
POSTGRES_PASSWORD=change-me-for-anything-but-local-dev
POSTGRES_PORT=5433

# Containerised API (docker compose --profile api). At least 32 bytes; generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=<generate-a-random-key>
API_PORT=8080
OPENAPI_ENABLED=true
